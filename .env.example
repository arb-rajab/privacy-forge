APP_NAME=privacy-forge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=privacy_forge
# R-01 (10-risk-register.md) / ADR-0003: this is the role the running
# application actually connects as. It does NOT own the schema and (per
# the add_restricted_runtime_role_for_audit_log migration) has UPDATE/
# DELETE genuinely revoked on audit_log_entries at the Postgres level —
# not just hidden by application code. `php artisan migrate` must NOT be
# run with these credentials; use DB_MIGRATE_* below for that.
DB_USERNAME=privacy_forge_app
DB_PASSWORD=privacy_forge_app_dev_only
# The schema-owning role: creates/owns every table, and is the only role
# these credentials should ever run `php artisan migrate --database=
# pgsql_migrate` as. This is the same role/credentials this project used
# for everything before R-01 was closed for real.
DB_MIGRATE_USERNAME=privacy_forge
DB_MIGRATE_PASSWORD=privacy_forge_dev_only

# --- Redis (queue backend, rate limiting, idempotency keys) ---
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# The app image (docker/Dockerfile) installs no phpredis PECL extension;
# composer.json declares predis/predis as a real userland dependency
# instead. This must stay set to predis, or config/database.php falls
# back to Laravel's own default ('phpredis'), which isn't installed.
REDIS_CLIENT=predis

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Session cookies per T-11 (06-security-threat-model.md): Secure/HttpOnly/
# SameSite=Strict are set in config/session.php, not here — no real value
# belongs in an env var for this.

# --- Object storage (S3-compatible; MinIO locally, per docker-compose.yml) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=privacy-forge-exports
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Export bundle TTL (NFR-007: must never exceed 72 hours) ---
EXPORT_BUNDLE_SIGNED_URL_TTL_HOURS=72

# --- DSAR rate limiting (NFR-006) ---
DSAR_SUBMISSION_RATE_LIMIT_PER_DAY=3

# --- DSAR status link TTL (NFR-007: must never exceed 72 hours) ---
DSAR_STATUS_LINK_TTL_HOURS=72

# --- Audit log chain anchoring (ADR-0003) ---
# Where the periodic chain-root anchor is pushed. Left blank in this
# example deliberately — a real destination is an operational decision
# made at deploy time, not a default value to copy blindly.
AUDIT_CHAIN_ANCHOR_DESTINATION=

# --- Connector webhook contract (ADR-0004) ---
CONNECTOR_WEBHOOK_MAX_RETRY_ATTEMPTS=5
CONNECTOR_CALLBACK_SIGNATURE_TOLERANCE_SECONDS=300
# R-06: base URL for the built-in reference/stub connector (both its
# registered webhook_url and its own outbound callback). Must be
# reachable from the `worker` container, not just `app` itself — the
# docker-compose service name `app` resolves correctly across
# containers; http://localhost:8000 (APP_URL's default) does not.
REFERENCE_CONNECTOR_BASE_URL=http://app:8000

# --- Demo instance mode (docs/project-memory/06-security-threat-model.md,
# "Demo Instance Data Safety") ---
# When true: disables connector registration entirely (not just hides it
# in the UI, per T-18), enables the scheduled reset job, and shows the
# public demo warning banner. Must be false (or unset) for any real
# deployment — this is not a cosmetic flag.
DEMO_MODE=false
DEMO_RESET_SCHEDULE="0 3 * * *"
# B-08, resolved Session 24: a single fixed, documented demo-viewer
# credential, re-created by every `demo:reset` — see config/demo.php's
# comment for why this is an acceptable simplification specifically
# because there is no live public instance to weigh it against
# (09-decision-log.md). Change these before ever considering a real
# public deployment.
DEMO_VIEWER_EMAIL=demo-viewer@privacy-forge.example
DEMO_VIEWER_PASSWORD=privacy-forge-demo-viewer

MAIL_MAILER=log

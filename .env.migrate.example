# Schema-owning Postgres role, used ONLY by the one-shot `migrate` Compose
# service (docker-compose.yml / docker-compose.prod.yml) for `php artisan
# migrate --database=pgsql_migrate` and `php artisan demo:reset`'s
# TRUNCATE step — never by the long-running `app`/`worker` services.
#
# R-01 (docs/project-memory/10-risk-register.md): the whole point of
# splitting the app's runtime role off from the schema owner is that a
# compromised app/worker process can't just read the owning role's
# credentials back out of its own environment and reconnect as it. That
# only holds if this file is genuinely never loaded by `app`/`worker` —
# it deliberately is not one of their `env_file:` entries. Keep it that
# way; do not merge this back into .env.
DB_MIGRATE_USERNAME=privacy_forge
DB_MIGRATE_PASSWORD=privacy_forge_dev_only
